\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></g></svg>\n      </button></div>\n</div>\n<span class=\"header__corner corner left bottom flex absolute pointer-events-none\">\n  <svg class=\"w-full h-auto\" viewBox=\"0 0 101 101\" stroke=\"none\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M101 0H0V101H1C1 45.7715 45.7715 1 101 1V0Z\"></path>\n    <path d=\"M1 101C1 45.7715 45.7715 1 101 1\" fill=\"none\"></path>\n  </svg>\n</span>\n<span class=\"header__corner corner right bottom flex absolute pointer-events-none\">\n  <svg class=\"w-full h-auto\" viewBox=\"0 0 101 101\" stroke=\"none\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M101 0H0V101H1C1 45.7715 45.7715 1 101 1V0Z\"></path>\n    <path d=\"M1 101C1 45.7715 45.7715 1 101 1\" fill=\"none\"></path>\n  </svg>\n</span><span class=\"header__cutout cutout opacity-0 absolute left-0 top-100 w-full pointer-events-none\"></span></header><overlay-element class=\"overlay opacity-0 z-1 fixed left-0 w-full pointer-events-none\"></overlay-element><script>\n  if (Shopify.designMode) {\n    document.documentElement.style.setProperty('--header-height', Math.round(document.getElementById('shopify-section-sections--17515247730873__header').clientHeight) + 'px');\n  }\n</script>\n\n\n</div>\n<!-- END sections: header-group --><!-- BEGIN sections: overlay-group -->\n<div id=\"shopify-section-sections--17515247698105__cart-drawer\" class=\"shopify-section shopify-section-group-overlay-group\"><script src=\"//www.polarpro.com/cdn/shop/t/537/assets/cart.js?v=157210617311319501611788206894\" defer></script><cart-drawer\n    id=\"CartDrawer\"\n    class=\"cart-drawer drawer drawer--end z-35 fixed bottom-0 left-0 h-full w-full pointer-events-none\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"Cart\"\n    data-section-id=\"sections--17515247698105__cart-drawer\"\n    shopify-design-mode\n    hidden\n  >\n    <overlay-element\n      class=\"overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none\"\n      aria-controls=\"CartDrawer\"\n      aria-expanded=\"false\"\n    ></overlay-element>\n    <div class=\"drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden\">\n      <gesture-element class=\"drawer__header flex justify-between opacity-0 invisible relative\">\n        <ul class=\"drawer__tabs flex gap-10\" is=\"tab-list\">\n          <li>\n            <button\n              class=\"drawer__tab relative\"\n              type=\"button\"\n              aria-controls=\"MiniCart-sections--17515247698105__cart-drawer\"\n              aria-expanded=\"true\"\n            >\n              <span class=\"drawer__title heading lg:text-2xl text-lg leading-none tracking-tight\" style=\"text-wrap: balance;\">Cart</span>\n              <cart-count\n                class=\"count absolute font-medium text-xs lg:text-sm leading-none\"\n                aria-label=\"0 items\"\n                \n                  hidden\n                \n              >0</cart-count>\n            </button>\n          </li><li>\n              <button\n                class=\"drawer__tab\"\n                type=\"button\"\n                aria-controls=\"RecentlyViewed-sections--17515247698105__cart-drawer\"\n                aria-expanded=\"false\"\n              >\n                <span class=\"drawer__title heading lg:text-2xl text-lg leading-none tracking-tight\" style=\"text-wrap: balance;\">Recently viewed</span>\n              </button>\n            </li></ul>\n        <button\n          class=\"button button--secondary button--close drawer__close hidden sm:flex items-center justify-center\"\n          type=\"button\"\n          is=\"hover-button\"\n          aria-controls=\"CartDrawer\"\n          aria-expanded=\"false\"\n          aria-label=\"Close\"\n        >\n          <span class=\"btn-fill\" data-fill></span>\n          <span class=\"btn-text\"><svg class=\"icon icon-close icon-sm\" viewBox=\"0 0 20 20\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 15L15 5M5 5L15 15\"></path>\n    </svg></span>\n        </button>\n      </gesture-element>\n\n      <div class=\"drawer__content opacity-0 invisible flex flex-col h-full grow shrink\">\n        <details id=\"MiniCart-sections--17515247698105__cart-drawer\" class=\"drawer__panel opacity-0 flex overflow-hidden\" open>\n          <summary class=\"sr-only\" tabindex=\"-1\">Cart</summary>\n          <div class=\"flex flex-col h-full\"><div class=\"drawer__scrollable relative flex justify-center items-start grow shrink text-center\">\n                <div class=\"drawer__empty grid gap-5 md:gap-8\">\n                  <h2 class=\"drawer__empty-text heading leading-none tracking-tight\">Your cart is currently empty.</h2>\n                  <div class=\"drawer__empty-message text-sm md:text-base leading-tight rte\"><p>Not sure where to start?<br/>Try these collections:</p></div>\n                  <ul class=\"drawer__empty-collections grid gap-3\"><li>\n                        <a class=\"flex items-center justify-between\" href=\"/collections/all\">\n                          <span class=\"flex items-center\">Continue shopping</span><svg class=\"icon icon-arrow-right icon-sm transform\" viewBox=\"0 0 21 20\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 10H18M18 10L12.1667 4.16675M18 10L12.1667 15.8334\"></path>\n    </svg></a>\n                      </li></ul>\n                </div>\n              </div><div class=\"drawer__scrollable relative flex flex-col gap-9 grow shrink hidden\"><cart-items class=\"block grow\" data-section-id=\"sections--17515247698105__cart-drawer\">\n                <ul class=\"horizontal-products grid\" role=\"list\"></ul>\n              </cart-items></div>\n            <div class=\"drawer__footer grid w-full hidden\"><div class=\"drawer__footer-bottom grid gap-6\">\n                <div class=\"grid gap-4 sm:grid-6\"><div class=\"grid grid-cols-2 gap-4\">\n                    <div class=\"tax-note text-sm sm:text-base rte\">Taxes and <a href=\"/policies/shipping-policy\">shipping</a> calculated at checkout</div>\n                    <div class=\"totals grid place-self-end gap-1\">\n                      <span class=\"totals__subtotal text-sm sm:text-base\">Subtotal</span>\n                      <div class=\"totals__subtotal-value text-lg-2xl font-bold leading-none tracking-tight\">\n                        $0.00 USD\n                      </div>\n                    </div>\n                  </div>\n                </div><form\n                    action=\"/cart\"\n                    method=\"POST\"\n                    novalidate\n                    class=\"drawer__footer-buttons grid grid-cols-12 gap-4\"\n                  ><button\n                        class=\"button button--primary icon-with-text col-span-6 md:col-span-7\"\n                        type=\"submit\"\n                        name=\"checkout\"\n                        is=\"hover-button\"\n                      >\n                        <span class=\"btn-fill\" data-fill></span>\n                        <span class=\"btn-text\"><svg class=\"icon icon-lock icon-sm hidden sm:block\" viewBox=\"0 0 20 20\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" d=\"M5.83333 6.66675V5.83341C5.83333 4.74781 5.83333 4.205 5.97218 3.76463C6.26651 2.83114 6.99772 2.09993 7.93122 1.8056C8.37159 1.66675 8.91439 1.66675 10 1.66675V1.66675C11.0856 1.66675 11.6284 1.66675 12.0688 1.8056C13.0023 2.09993 13.7335 2.83114 14.0278 3.76463C14.1667 4.205 14.1667 4.74781 14.1667 5.83341V6.66675M10 11.6667V13.3334M8.33333 18.3334H11.6667C13.3741 18.3334 14.2278 18.3334 14.909 18.077C15.9871 17.6713 16.8379 16.8205 17.2436 15.7424C17.5 15.0612 17.5 14.2075 17.5 12.5001V12.5001C17.5 10.7926 17.5 9.93892 17.2436 9.25775C16.8379 8.17969 15.9871 7.32888 14.909 6.92312C14.2278 6.66675 13.3741 6.66675 11.6667 6.66675H8.33333C6.62589 6.66675 5.77218 6.66675 5.091 6.92312C4.01294 7.32888 3.16213 8.17969 2.75638 9.25775C2.5 9.93892 2.5 10.7926 2.5 12.5001V12.5001C2.5 14.2075 2.5 15.0612 2.75638 15.7424C3.16213 16.8205 4.01294 17.6713 5.091 18.077C5.77218 18.3334 6.62589 18.3334 8.33333 18.3334Z\"></path>\n    </svg>Check out</span>\n                      </button><a\n                        href=\"/cart\"\n                        class=\"button button--secondary col-span-6 md:col-span-5\"\n                        is=\"hover-link\"\n                        data-no-instant\n                      >\n                        <span class=\"btn-fill\" data-fill></span>\n                        <span class=\"btn-text\">View cart</span>\n                      </a></form></div>\n            </div>\n          </div>\n        </details><details id=\"RecentlyViewed-sections--17515247698105__cart-drawer\" class=\"drawer__panel opacity-0 flex h-full overflow-hidden\">\n            <summary class=\"sr-only\" tabindex=\"-1\">Recently viewed</summary>\n            <recently-viewed\n              class=\"cart__recent flex flex-col h-full\"\n              data-url=\"/search?section_id=sections--17515247698105__cart-drawer&type=product&q=\"\n              data-limit=\"5\"\n              \n            ></recently-viewed>\n          </details></div>\n    </div>\n  </cart-drawer><script>\n(function() {\n  let bundleDiscountApplied = false;\n  \n  function applyBundleDiscounts() {\n    const cartDrawer = document.getElementById('CartDrawer');\n    if (!cartDrawer || cartDrawer.hasAttribute('hidden')) {\n      return;\n    }\n\n    fetch(window.Shopify.routes.root + 'cart.js')\n      .then(response => response.json())\n      .then(cart => {\n        let bundleCount = 0;\n        const bundleItemsData = {};\n        \n        cart.items.forEach(item => {\n          if (item.properties && item.properties._Bundle) {\n            bundleCount += item.quantity;\n            bundleItemsData[item.key] = {\n              price: item.price,\n              quantity: item.quantity\n            };\n          }\n        });\n\n        let discount = 0;\n        if (bundleCount === 2) {\n          discount = 0.15;\n        } else if (bundleCount >= 3) {\n          discount = 0.20;\n        }\n\n        Object.keys(bundleItemsData).forEach(itemKey => {\n          const itemElement = document.querySelector(`#CartDrawer-Item-${itemKey}`);\n          if (!itemElement) return;\n\n          const priceElement = itemElement.querySelector('.price');\n          if (!priceElement) return;\n\n          const originalPrice = bundleItemsData[itemKey].price;\n          \n          if (discount > 0) {\n            const priceInDollars = originalPrice / 100;\n            const discountedPriceInDollars = priceInDollars * (1 - discount);\n            const discountedPrice = Math.ceil(discountedPriceInDollars * 100);\n            \n            const formatMoney = (cents) => {\n              return `$${(cents / 100).toFixed(2)}`;\n            };\n\n            const originalPriceFormatted = formatMoney(originalPrice);\n            const discountedPriceFormatted = formatMoney(discountedPrice);\n\n            priceElement.innerHTML = `\n              <span style=\"text-decoration: line-through; color: #999; font-size: 0.9em; margin-right: 6px;\">${originalPriceFormatted}</span>\n              <span style=\"font-weight: 700; color: #c53030;\">${discountedPriceFormatted}</span>\n            `;\n            priceElement.classList.add('price--on-sale');\n            priceElement.setAttribute('data-bundle-discount', discount);\n          } else {\n            const formatMoney = (cents) => {\n              return `$${(cents / 100).toFixed(2)}`;\n            };\n            \n            if (priceElement.hasAttribute('data-bundle-discount')) {\n              priceElement.innerHTML = formatMoney(originalPrice);\n              priceElement.classList.remove('price--on-sale');\n              priceElement.removeAttribute('data-bundle-discount');\n            }\n          }\n        });\n        \n        bundleDiscountApplied = true;\n      })\n      .catch(error => {\n        console.error('Bundle discount error:', error);\n      });\n  }\n\n  function initBundleDiscounts() {\n    setTimeout(() => {\n      applyBundleDiscounts();\n    }, 200);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initBundleDiscounts);\n  } else {\n    initBundleDiscounts();\n  }\n\n  document.addEventListener('cart:updated', () => {\n    setTimeout(applyBundleDiscounts, 100);\n  });\n  \n  const cartDrawer = document.getElementById('CartDrawer');\n  if (cartDrawer) {\n    const observer = new MutationObserver((mutations) => {\n      mutations.forEach((mutation) => {\n        if (mutation.attributeName === 'hidden') {\n          if (!cartDrawer.hasAttribute('hidden')) {\n            setTimeout(applyBundleDiscounts, 300);\n          }\n        }\n      });\n    });\n    observer.observe(cartDrawer, { attributes: true });\n  }\n\n  if (typeof theme !== 'undefined' && theme.pubsub) {\n    theme.pubsub.subscribe(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, () => {\n      setTimeout(applyBundleDiscounts, 150);\n    });\n  }\n})();\n</script>\n\n\n</div><div id=\"shopify-section-sections--17515247698105__search-drawer\" class=\"shopify-section shopify-section-group-overlay-group\"><script src=\"//www.polarpro.com/cdn/shop/t/537/assets/search.js?v=153964456974568625491731278479\" defer></script><search-drawer id=\"SearchDrawer\" class=\"search-drawer drawer drawer--end z-35 fixed bottom-0 left-0 h-full w-full pointer-events-none\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"Search\"\n    shopify-design-mode\n    hidden\n  >\n    <overlay-element class=\"overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none\" aria-controls=\"SearchDrawer\" aria-expanded=\"false\"></overlay-element>\n    <div class=\"drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden\">\n      <gesture-element class=\"drawer__header flex justify-between opacity-0 invisible relative\">\n        <span class=\"drawer__title heading lg:text-3xl text-2xl leading-none tracking-tight\">Search</span>\n        <button class=\"button button--secondary button--close drawer__close hidden sm:flex items-center justify-center\" type=\"button\" is=\"hover-button\" aria-controls=\"SearchDrawer\" aria-expanded=\"false\" aria-label=\"Close\">\n          <span class=\"btn-fill\" data-fill></span>\n          <span class=\"btn-text\"><svg class=\"icon icon-close icon-sm\" viewBox=\"0 0 20 20\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 15L15 5M5 5L15 15\"></path>\n    </svg></span>\n        </button>\n      </gesture-element>\n      <div class=\"drawer__content opacity-0 invisible flex flex-col h-full grow shrink\">\n        <div class=\"drawer__scrollable relative flex flex-col grow shrink\"><form class=\"search__form flex flex-col gap-8 h-full relative\" action=\"/search\" method=\"GET\" role=\"search\"\n    is=\"predictive-search\"\n    data-section-id=\"sections--17515247698105__search-drawer\"\n    data-limit=\"3\"\n  >\n  <input type=\"hidden\" name=\"options[prefix]\" value=\"last\" />\n  <label class=\"sr-only\" for=\"SearchFormInput-sections--17515247698105__search-drawer\">Search</label>\n  <div class=\"search__field field flex items-center gap-4 relative\"><input\n      class=\"input search__input\"\n      type=\"search\"\n      name=\"q\"\n      id=\"SearchFormInput-sections--17515247698105__search-drawer\"\n      placeholder=\"Search for ...\"\n      autocomplete=\"off\"\n      autocorrect=\"off\"\n      autocapitalize=\"off\"\n      spellcheck=\"off\"/>\n      <button class=\"clear absolute flex items-center justify-center text-xs opacity-0\" type=\"reset\">\n        <span>Clear</span><svg class=\"icon icon-loader icon-sm absolute opacity-0 invisible animate-spin\" viewBox=\"0 0 18 18\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M0.7,9.9C0.5,5.2,4.1,1.2,8.5,1c4.7-0.3,8.9,3.8,8.8,8.8\"></path>\n    </svg></button></div>\n    <div id=\"PredictiveSearchResults-sections--17515247698105__search-drawer\" class=\"search__box search__results text-left flex flex-col items-start grow gap-10\" role=\"listbox\"></div></form>\n</div>\n      </div>\n    </div>\n  </search-drawer>\n</div><div id=\"shopify-section-sections--17515247698105__preorder_modal_nfJKKg\" class=\"shopify-section shopify-section-group-overlay-group\">\n\n<script type=\"application/json\" id=\"PreOrderVariantData\">\n  {\n    \n  }\n</script><div id=\"PreOrderModal\" class=\"preorder-modal-overlay\" style=\"display: none;\">\n  <div class=\"preorder-modal-content\">\n    \n    <img src=\"//www.polarpro.com/cdn/shop/files/Layer.svg?v=1767637730\" class=\"modal-bg-image\" alt=\"Background Pattern\" loading=\"lazy\">\n    \n    <div class=\"modal-body\">\n      \n        <div class=\"modal-icon\">\n          <img src=\"//www.polarpro.com/cdn/shop/files/logo.svg?v=1767631507&width=300\" alt=\"Brand Icon\" loading=\"lazy\">\n        </div>\n      \n\n      <div class=\"modal-text-group\">\n          <h3 class=\"modal-title\" style=\"color: #ae8a5a;\">\n            THIS IS A PRE-ORDER ITEM.\n          </h3>\n          \n          <p id=\"PreOrderDateText\" class=\"modal-text\" style=\"display: none;\">\n            THE ORDER IS ESTIMATED TO SHIP ON <span id=\"DynamicDate\">OCT 25</span>\n          </p>\n          <p id=\"PreOrderGenericText\" class=\"modal-text\" style=\"display: none;\">\n            ONE OR MORE ITEMS IN THIS ORDER ARE A PRE-ORDER.\n          </p>\n      </div>\n\n      <button id=\"ConfirmPreOrder\" type=\"button\" class=\"modal-confirm-btn\">\n        CONFIRM <span class=\"arrow\">&rarr;</span>\n      </button>\n    </div>\n  </div>\n</div>\n\n<style>\n  /* Overlay */\n  .preorder-modal-overlay {\n    position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n    background: rgba(0, 0, 0, 0.4); z-index: 999999;\n    justify-content: center; align-items: center;\n    backdrop-filter: blur(0.5px);\n  }\n\n  /* --- MODAL BOX --- */\n  .preorder-modal-content {\n    background: #fff;\n    border-radius: 20px;\n    position: relative; overflow: hidden;\n    box-shadow: 0 15px 50px rgba(0,0,0,0.4);\n    text-align: center;\n    \n    /* Default Padding (Desktop) */\n    padding: 50px 40px;\n    width: 550px; \n    max-width: 90%; \n  }\n\n  /* Background Image */\n  .modal-bg-image {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    object-fit: cover; \n    z-index: 1; \n    opacity: 1; \n    pointer-events: none;\n  }\n\n  .modal-body { position: relative; z-index: 2; }\n  \n  /* --- LOGO SIZE CONTROL --- */\n  .modal-icon img { \n    display: block; margin: 0 auto 20px auto; \n    width: 130px; \n  }\n  \n  @media screen and (min-width: 768px) {\n    .modal-icon img { \n      width: 160px; \n      margin-bottom: 25px;\n    }\n  }\n\n  /* --- TYPOGRAPHY --- */\n  .modal-title { \n    font-family: 'Helvetica Neue LT Pro', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    font-weight: 700; \n    font-stretch: condensed;\n    line-height: 100%; letter-spacing: 0px; text-transform: uppercase;\n    font-size: 13px; \n    margin-bottom: 0px; \n    padding-bottom: 0px;\n    white-space: nowrap; \n  }\n\n  .modal-text { \n    color: #000; \n    font-family: 'Helvetica Neue LT Pro', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    font-weight: 700; \n    font-stretch: condensed;\n    line-height: 100%; letter-spacing: 0px; text-transform: uppercase;\n    font-size: 9px; \n    margin-top: 2px; \n    margin-bottom: 30px; \n    white-space: nowrap; \n  }\n\n  #PreOrderGenericText {\n    white-space: normal;\n    line-height: 1.2;\n  }\n  \n  #DynamicDate { font-weight: 700; }\n\n  /* --- DESKTOP FONT SIZES --- */\n  @media screen and (min-width: 768px) {\n    .modal-title { \n      font-size: 24px; \n      margin-bottom: 0px; \n    }\n    .modal-text { \n      font-size: 17px; \n      margin-bottom: 35px; \n    } \n  }\n  \n  /* --- BUTTON STYLING --- */\n  .modal-confirm-btn {\n    position: relative; \n    background: #000; \n    color: #fff; \n    border: none;\n    padding: 18px 20px;\n    width: 100%; \n    max-width: 280px; \n    border-radius: 50px; \n    cursor: pointer; \n    display: inline-flex; \n    align-items: center; \n    justify-content: center; \n    transition: transform 0.2s ease;\n    font-family: 'Helvetica Neue LT Pro', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    font-weight: 400; \n    font-stretch: condensed; \n    text-transform: uppercase; \n    letter-spacing: 1px;\n    font-size: 16px; \n    line-height: 100%;\n  }\n\n  .modal-confirm-btn .arrow {\n    position: absolute; \n    right: 45px; \n    font-size: 18px;\n  }\n\n  .modal-confirm-btn:hover { \n    transform: scale(1.03); \n  }\n\n  /* ========================================= */\n  /* === MOBILE LAYOUT FIXES (POSITIONING) === */\n  /* ========================================= */\n  @media screen and (max-width: 767px) {\n    .preorder-modal-content {\n        width: 70%;\n        max-width: 330px;\n        min-height: 340px; \n        \n        /* Padding Wapis Normal (Balance) */\n        padding: 50px 20px !important; \n        \n        display: flex;\n        flex-direction: column;\n    }\n\n    .modal-body {\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between; \n        align-items: center;\n    }\n\n    /* --- LOGO MOVEMENT LOGIC --- */\n    .modal-icon {\n        margin: 0;\n        \n        /* Is magic line se Logo Visual tor par nichy aye ga, \n           lekin Text ko push nahi kare ga.\n        */\n        position: relative; \n        top: 40px; /* <--- Yeh value adjust kr k logo ko aur nichy/uper kr sakty hain */\n    }\n\n    /* Text Positioning */\n    .modal-text-group {\n        flex: 1; \n        display: flex;\n        flex-direction: column;\n        justify-content: center; \n        margin-bottom: 10px;\n    }\n\n    .modal-title, .modal-text {\n        white-space: normal; \n        margin-bottom: 5px;\n    }\n    .modal-text {\n        margin-bottom: 0;\n    }\n\n    /* Button Positioning */\n    .modal-confirm-btn {\n        padding: 16px 20px;\n        font-size: 14px;\n        max-width: 250px;\n        margin: 0;\n    }\n    .modal-confirm-btn .arrow {\n        right: 35px; \n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    const modal = document.getElementById(\"PreOrderModal\");\n    const confirmBtn = document.getElementById(\"ConfirmPreOrder\");\n    const dateText = document.getElementById(\"PreOrderDateText\");\n    const dateSpan = document.getElementById(\"DynamicDate\");\n    const genericText = document.getElementById(\"PreOrderGenericText\");\n    \n    \n\n    if (!modal || !confirmBtn) return;\n\n    const variantDataEl = document.getElementById(\"PreOrderVariantData\");\n    const variantData = variantDataEl ? JSON.parse(variantDataEl.textContent) : {};\n    let clickedButton = null;\n\n    window.PolarProPreorderModal = {\n      open({ mode, date, button } = {}) {\n        if (!button) return;\n\n        clickedButton = button;\n\n        if (mode === 'generic') {\n          if (dateText) dateText.style.display = 'none';\n          if (genericText) genericText.style.display = 'block';\n        } else {\n          if (genericText) genericText.style.display = 'none';\n          if (date && String(date).trim() !== '') {\n            if (dateSpan) dateSpan.innerText = date;\n            if (dateText) dateText.style.display = 'block';\n          } else if (dateText) {\n            dateText.style.display = 'none';\n          }\n        }\n\n        modal.style.display = 'flex';\n      }\n    };\n\n    const addToCartButtons = document.querySelectorAll('form[action*=\"/cart/add\"] button[name=\"add\"]');\n\n    addToCartButtons.forEach(btn => {\n      btn.addEventListener(\"click\", function(e) {\n        if (btn.hasAttribute(\"data-preorder-confirmed\")) { return; }\n\n        const form = btn.closest(\"form\");\n        if (!form) return;\n\n        const formData = new FormData(form);\n        const currentId = formData.get('id');\n        const currentVariant = variantData[currentId];\n\n        if (currentVariant && currentVariant.qty <= 0 && currentVariant.policy === 'continue') {\n          e.preventDefault();\n          e.stopImmediatePropagation();\n          window.PolarProPreorderModal.open({\n            mode: 'single',\n            date: currentVariant.date,\n            button: btn\n          });\n        }\n      });\n    });\n\n    confirmBtn.addEventListener(\"click\", function() {\n      if (clickedButton) {\n        modal.style.display = \"none\";\n        clickedButton.setAttribute(\"data-preorder-confirmed\", \"true\");\n        clickedButton.click();\n        setTimeout(() => {\n            clickedButton.removeAttribute(\"data-preorder-confirmed\");\n            clickedButton = null;\n        }, 1000);\n      }\n    });\n\n    modal.addEventListener(\"click\", function(e) {\n      if (e.target === modal) modal.style.display = \"none\";\n    });\n  });\n</script></div>\n<!-- END sections: overlay-group --><div class=\"page-container\" id=\"PageContainer\">\n    <main class=\"main-content relative\" id=\"MainContent\" role=\"main\">\n      <div id=\"shopify-section-template--17515248681145__image_with_text_overlay_jdikXt\" class=\"shopify-section\"><style>\n  #shopify-section-template--17515248681145__image_with_text_overlay_jdikXt {\n    --section-padding-top: 0px;\n    --section-padding-bottom: 0px;--color-foreground: 255 255 255;\n  --color-border: var(--color-foreground)/ 0.1;\n  --color-border-dark: var(--color-foreground)/ 0.4;\n  --color-border-light: var(--color-foreground)/ 0.06;--color-highlight: 224 165 128;--color-button-background: 255 255 255;\n  --color-button-border: 255 255 255;--color-button-text: 23 23 23;--color-overlay: 23 23 23;--overlay-opacity: 0.0;}@media screen and (max-width: 767px) {\n    #shopify-section-template--17515248681145__image_with_text_overlay_jdikXt .banner__title {\n      line-height: 1;\n    }\n\n    #shopify-section-template--17515248681145__image_with_text_overlay_jdikXt .banner__box .rte {\n      font-size: 0.8125rem !important;\n      line-height: 1.35;\n    }\n  }\n</style>\n\n<div class=\"section section--padding\">\n  <div class=\"relative\">\n    <div class=\"banner media--650px mobile:media--auto relative\">\n      <media-element class=\"banner__media block w-full h-full overflow-hidden\" data-parallax=\"0.3\" data-parallax-dir=\"vertical\">\n        <picture class=\"media media--height block w-full h-full relative overflow-hidden\" is=\"animate-picture\" data-animate=\"zoom-out\"><img src=\"//www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=2000\" alt=\"\" srcset=\"//www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=300 300w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=400 400w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=500 500w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=600 600w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=700 700w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=800 800w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=900 900w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=1000 1000w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=1200 1200w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=1400 1400w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=1600 1600w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=1800 1800w, //www.polarpro.com/cdn/shop/files/litechaser-18-hp-hero.jpg?v=1788910767&amp;width=2000 2000w\" width=\"2000\" height=\"750\" loading=\"lazy\" sizes=\"100vw\" is=\"lazy-image\" class=\"banner__image\"></picture>\n      </media-element><span class=\"banner__overlay absolute top-0 left-0 w-full h-full pointer-events-none\"></span>\n        <div class=\"banner__content overflow-hidden absolute z-1 top-0 left-0 w-full h-full\">\n          <div class=\"page-width w-full h-full flex md:items-end md:justify-start items-end justify-center\">\n            <div class=\"banner__box banner__box--small md:text-left text-center\"><p class=\"banner__subheading uppercase leading-none tracking-widest subtitle-md\" >Now Available</p><empty-element class=\"block spacing-section\" style=\"--spacing-height-desktop: 4px; --spacing-height-mobile: 8px;\" ></empty-element><h2 class=\"banner__title heading leading-tiny title-md\" ><split-words class=\"split-words block\" data-animate=\"fade-up-large\" data-animate-delay=\"250\"><p>LITECHASER 18</p></split-words></h2><div class=\"rte leading-normal body subtext-md\" ><p>Transform your iPhone 18 Pro into a minimalist handheld camera rig.</p></div><a class=\"button button--primary button--fixed button--md icon-with-text\" href=\"/products/litechaser-18\" is=\"hover-link\" >\n                        <span class=\"btn-fill\" data-fill></span>\n                        <span class=\"btn-text\">Shop Now<svg class=\"icon icon-arrow-right icon-sm transform\" viewBox=\"0 0 21 20\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 10H18M18 10L12.1667 4.16675M18 10L12.1667 15.8334\"></path>\n    </svg></span>\n                      </a></div>\n          </div>\n        </div></div>\n  </div>\n</div>\n\n\n</div><div id=\"shopify-section-template--17515248681145__featured_collection_CXCNyQ\" class=\"shopify-section\"><style>\n  #shopify-section-template--17515248681145__featured_collection_CXCNyQ {\n    --section-padding-top: 72px;\n    --section-padding-bottom: 72px;--color-background: 0 0 0;--color-foreground: 0 0 0;\n  --color-border: var(--color-foreground)/ 0.1;\n  --color-border-dark: var(--color-foreground)/ 0.4;\n  --color-border-light: var(--color-foreground)/ 0.06;\n  }\n</style>\n\n<style>\n  #featured-collection { scroll-margin-top: 50px; }\n</style><div id=\"featured-collection\" class=\"section section--padding\">\n  <script>\n    (function() {\n      function scrollToAnchorIfNeeded() {\n        if (location.hash === '#featured-collection') {\n          var el = document.getElementById('featured-collection');\n          if (!el) return;\n          var offset = 50; // match scroll-margin-top\n          var top = el.getBoundingClientRect().top + window.pageYOffset - offset;\n          window.scrollTo({ top: top, behavior: 'smooth' });\n        }\n      }\n      window.addEventListener('hashchange', function() { setTimeout(scrollToAnchorIfNeeded, 0); });\n      document.addEventListener('DOMContentLoaded', function() { setTimeout(scrollToAnchorIfNeeded, 0); });\n      // In case scripts run after onload and reset scroll\n      window.addEventListener('load', function() { setTimeout(scrollToAnchorIfNeeded, 50); });\n    })();\n  </script>\n  <div class=\"page-width relative\"><div class=\"title-wrapper leading-none gap-4 lg:gap-8 flex flex-col text-left md:items-end md:flex-row md:justify-between relative z-1\"><div class=\"grid gap-4\"><h2 class=\"heading title-md seventy-five-bold\"><split-words class=\"split-words block\" data-animate=\"fade-up-large\"></split-words>\n              <split-words class=\"split-words block\" data-animate=\"fade-up-large\">Best Sellers</split-words></h2></div><div class=\"indicators hidden lg:flex gap-2d5\">\n          <button class=\"button button--secondary\" type=\"button\" is=\"previous-button\" aria-controls=\"Slider-template--17515248681145__featured_collection_CXCNyQ\" aria-label=\"Previous\" disabled>\n            <span class=\"btn-fill\" data-fill></span>\n            <span class=\"btn-text\"><svg class=\"icon icon-chevron-left icon-md transform\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 6L8 12L14 18\"></path>\n    </svg></span>\n          </button>\n          <button class=\"button button--secondary\" type=\"button\" is=\"next-button\" aria-controls=\"Slider-template--17515248681145__featured_collection_CXCNyQ\" aria-label=\"Next\">\n            <span class=\"btn-fill\" data-fill></span>\n            <span class=\"btn-text\"><svg class=\"icon icon-chevron-right icon-md transform\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10 6L16 12L10 18\"></path>\n    </svg></span>\n          </button>\n        </div>\n        <p class=\"lg:hidden\"></p></div><slider-element id=\"Slider-template--17515248681145__featured_collection_CXCNyQ\" class=\"grid slider slider--desktop slider--tablet\" selector=\".card-grid>.card\">\n      <motion-list class=\"product-grid card-grid card-grid--5 mobile:card-grid--1 grid\">\n        \