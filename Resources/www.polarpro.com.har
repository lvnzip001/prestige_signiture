orDiv=form.querySelector(\".error-message\")||document.createElement(\"div\");errorDiv.className=\"error-message text-red-500 text-sm mt-2\",errorDiv.textContent=\"Sorry, there was an error. Please try again.\",form.querySelector(\".error-message\")||form.appendChild(errorDiv)}})})});\n//# sourceMappingURL=/cdn/shop/t/537/assets/back-in-stock-form.js.map?v=151026964001617825241747435392\n"
