214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=2304\" alt=\"Load video: \" srcset=\"//www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=300 300w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=400 400w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=500 500w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=600 600w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=700 700w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=800 800w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=900 900w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=1000 1000w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=1200 1200w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=1400 1400w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=1600 1600w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=1800 1800w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=2000 2000w, //www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000.jpg?v=1737739902&amp;width=2200 2200w\" width=\"2304\" height=\"1080\" loading=\"lazy\" fetchpriority=\"auto\" sizes=\"100vw\" is=\"lazy-image\" style=\"height: inherit; width: 100%;\"><template><video playsinline=\"true\" muted=\"muted\" autoplay=\"autoplay\" loop=\"loop\" preload=\"none\" poster=\"//www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000_800x.jpg?v=1737739902\" loading=\"lazy\"><source src=\"//www.polarpro.com/cdn/shop/videos/c/vp/4fea2975085340c79ff4b6214ece5975/4fea2975085340c79ff4b6214ece5975.HD-1080p-7.2Mbps-41533369.mp4?v=0\" type=\"video/mp4\"><img src=\"//www.polarpro.com/cdn/shop/files/preview_images/4fea2975085340c79ff4b6214ece5975.thumbnail.0000000000_800x.jpg?v=1737739902\"></video></template></video-media><script>\n  function openVideoModal(videoUrl) {\n  // Replace standard YouTube URL with embed URL and add autoplay parameter\n  const embedUrl = videoUrl.replace(\"watch?v=\", \"embed/\") + \"?si=UB05IU2Nb5wMKUnw&autoplay=1\";\n  document.body.classList.add('show-video-modal', 'noscroll');\n  console.log(embedUrl);\n  \n  const modalHtml = `\n    <div class=\"video-modal\">\n    <div class=\"overlay\" onclick=\"closeVideoModal()\"></div>\n    <div class=\"video-modal-content\">\n      <iframe id=\"youtube\" width=\"100%\" height=\"100%\" frameborder=\"0\" allow=\"autoplay\" allowfullscreen src=\"${embedUrl}\"></iframe>\n      <div class=\"close-video-modal\">\n        <a href=\"#\" onclick=\"closeVideoModal(event)\">\n        <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"x=\"0\"y=\"0\"viewBox=\"0 0 32 32\" style=\"enable-background:new 0 0 32 32;\" xml:space=\"preserve\" width=\"24\" height=\"24\">\n          <g id=\"icon-x-close\">\n          <path fill=\"#ffffff\" d=\"M30.3448276,31.4576271 C29.9059965,31.4572473 29.4852797,31.2855701 29.1751724,30.980339 L0.485517241,2.77694915 C-0.122171278,2.13584324 -0.104240278,1.13679247 0.52607603,0.517159487 C1.15639234,-0.102473494 2.17266813,-0.120100579 2.82482759,0.477288136 L31.5144828,28.680678 C31.9872448,29.1460053 32.1285698,29.8453523 31.8726333,30.4529866 C31.6166968,31.0606209 31.0138299,31.4570487 30.3448276,31.4576271 Z\" id=\"Shape\"></path>\n          <path fill=\"#ffffff\" d=\"M1.65517241,31.4576271 C0.986170142,31.4570487 0.383303157,31.0606209 0.127366673,30.4529866 C-0.12856981,29.8453523 0.0127551942,29.1460053 0.485517241,28.680678 L29.1751724,0.477288136 C29.8273319,-0.120100579 30.8436077,-0.102473494 31.473924,0.517159487 C32.1042403,1.13679247 32.1221713,2.13584324 31.5144828,2.77694915 L2.82482759,30.980339 C2.51472031,31.2855701 2.09400353,31.4572473 1.65517241,31.4576271 Z\" id=\"Shape\"></path>\n          </g>\n        </svg>\n        </a>\n      </div>\n    </div>\n    </div>\n  `;\n  \n  document.body.insertAdjacentHTML('beforeend', modalHtml);\n  }\n\n  function closeVideoModal(event) {\n  if (event) event.preventDefault();\n  const modal = document.querySelector('.video-modal');\n  if (modal) {\n    modal.remove();\n    document.body.classList.remove('show-video-modal', 'noscroll');\n  }\n  }\n</script>\n\n<style>\n  /* Video Modal */\n  .video-modal,\n  .video-modal .overlay {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  z-index: 3000;\n  }\n  .video-modal {\n  overflow: hidden;\n  position: fixed;\n  opacity: 0.0;\n  transform: translate(500%,0%);\n  transition: transform 0s linear 0s;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transform-style: preserve-3d;\n  }\n  .video-modal .overlay {\n  z-index: 0;\n  background: rgba(13,1,61,0.82); /* overlay color */\n  opacity: 0.0;\n  transition: opacity 0.2s ease-out 0.05s;\n  }\n  .video-modal-content {\n  position: relative;\n  z-index: 2999;\n  margin: 0 auto;\n  background: #000;\n  width: calc(100% - 12em);\n  height: 0;\n  padding-top: calc((100% - 12em) * 0.5625); /* 16:9 calc */\n  }\n  @media (min-aspect-ratio: 16/9) {\n  .video-modal-content {\n    width: 0;\n    height: calc(100vh - 10em);\n    padding-top: 0;\n    padding-left: calc((100vh - 10em) * 1.7778); /* 16:9 calc */\n  }\n  }\n  @media (max-width: 640px) {\n  .video-modal-content {\n    width: calc(100% - 1em);\n    padding-top: calc((100% - 1em) * 0.5625); /* 16:9 calc */\n  }\n  }\n  .close-video-modal {\n  display: block;\n  position: fixed;\n  top: 10px;\n  right: 10px;\n  text-decoration: none;\n  font-size: 30px;\n  font-weight: bold;\n  color: #fff;\n  z-index: 3000;\n  }\n  iframe#youtube {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  z-index: 2999;\n  background: #000;\n  box-shadow: 0px 2px 16px rgba(0,0,0,0.5);\n  }\n  .show-video-modal .video-modal {\n  opacity: 1.0;\n  transform: translate(0%,0%);\n  background: rgba(64, 64, 64, 0.7);\n  }\n  .show-video-modal .video-modal .overlay {\n  opacity: 1.0;\n  }\n  .show-video-modal .video-modal-content {\n  transform: translate(0%,0%);\n  }\n  .noscroll { \n  overflow: hidden;\n  }\n</style>\n<span class=\"banner__overlay absolute top-0 left-0 w-full h-full pointer-events-none\"></span>\n      <div class=\"banner__content overflow-hidden absolute z-1 top-0 left-0 w-full h-full\">\n        <div class=\"page-width w-full h-full flex md:items-center md:justify-center items-center justify-center\">\n          <div class=\"banner__box banner__box--small md:text-center text-center\">  \n            \n  \n          </div>\n        </div>\n      </div><span class=\"banner__overlay absolute top-0 left-0 w-full h-full pointer-events-none\"></span>\n        <div class=\"banner__content overflow-hidden absolute z-1 top-0 left-0 w-full h-full\">\n          <div class=\"page-width w-full h-full flex md:items-center md:justify-center items-center justify-center\">\n            <div class=\"banner__box banner__box--small md:text-center text-center\"><div class=\"leading-none\" >\n                        